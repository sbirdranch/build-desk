{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://build-desk.local/contracts/order-event-v1.schema.json",
  "title": "Build Desk Order Update v1",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "build_id",
    "vendor",
    "order_number",
    "created_at",
    "event_at",
    "source",
    "facts",
    "supersedes_event_ids"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^k745-[a-f0-9]{64}$"
    },
    "build_id": {
      "const": "kitten-745"
    },
    "vendor": {
      "const": "aliexpress"
    },
    "order_number": {
      "type": "string",
      "maxLength": 200,
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "event_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "gmail_message_id",
        "gmail_thread_id",
        "message_date",
        "subject",
        "forwarded",
        "original_sender"
      ],
      "properties": {
        "gmail_message_id": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1
        },
        "gmail_thread_id": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1
        },
        "message_date": {
          "type": "string",
          "format": "date-time"
        },
        "subject": {
          "type": "string",
          "maxLength": 2000
        },
        "forwarded": {
          "type": "boolean"
        },
        "original_sender": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "gmail_url": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "additionalProperties": false
    },
    "facts": {
      "type": "object",
      "required": [
        "order_date",
        "currency",
        "order_total",
        "items"
      ],
      "properties": {
        "order_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "order_total": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{1,12}(\\.\\d{1,6})?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "source_item_id",
              "description",
              "specification",
              "seller",
              "ordered_quantity",
              "unit_basis",
              "pack_size",
              "unit_price",
              "line_total",
              "shipping_amount",
              "tax_amount",
              "status",
              "status_quantity",
              "tracking",
              "suggested_part_id",
              "evidence"
            ],
            "properties": {
              "source_item_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 2000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "description": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 2000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "specification": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 2000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "seller": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 2000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "ordered_quantity": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "unit_basis": {
                "enum": [
                  "component",
                  "pack",
                  "unknown"
                ]
              },
              "pack_size": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "unit_price": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{1,12}(\\.\\d{1,6})?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "line_total": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{1,12}(\\.\\d{1,6})?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "shipping_amount": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{1,12}(\\.\\d{1,6})?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "tax_amount": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{1,12}(\\.\\d{1,6})?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "enum": [
                  "ordered",
                  "shipped",
                  "delivered_by_carrier",
                  "cancelled",
                  null
                ]
              },
              "status_quantity": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "tracking": {
                "type": "array",
                "maxItems": 30,
                "items": {
                  "type": "object",
                  "required": [
                    "carrier",
                    "tracking_number"
                  ],
                  "properties": {
                    "carrier": {
                      "type": "string",
                      "maxLength": 2000
                    },
                    "tracking_number": {
                      "type": "string",
                      "maxLength": 2000
                    }
                  },
                  "additionalProperties": false
                }
              },
              "suggested_part_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 2000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "evidence": {
                "type": "string",
                "maxLength": 4000
              }
            },
            "additionalProperties": false
          }
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        },
        "original_order_reference": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "additionalProperties": false
    },
    "supersedes_event_ids": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 120
      }
    }
  },
  "additionalProperties": false
}
